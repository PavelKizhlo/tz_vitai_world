# Заявки с формы приходят сообщением в Telegram (src/components/Order/actions.ts).
# Скопируйте в .env.local локально и заведите те же переменные в настройках проекта на Vercel.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Чат, куда бот пишет заявки: личный id, группа (начинается с -) или канал; бот должен быть в нём
TELEGRAM_CHAT_ID=
